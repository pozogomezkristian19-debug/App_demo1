<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la tarjeta del widget de inicio (mejorado, 2026-11-18,
     diseño v3 aprobado por Kristian: tarjeta estilo Duolingo, borde
     y labio sólido abajo como los botones de la app). La capa de
     abajo (labio) asoma 4dp por debajo de la tarjeta. Los colores
     salen de widget_colors.xml (con variante night en oscuro). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/widget_card_lip" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <solid android:color="@color/widget_card" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
