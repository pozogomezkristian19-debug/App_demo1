<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo en frío, API 21+ (Quemia 7.3): ANTES este archivo
     era la plantilla POR DEFECTO (?android:colorBackground, sin logo)
     y en API 21+ GANABA sobre drawable/launch_background.xml, así que
     al abrir en frío se veía la pantalla en negro. Ahora es la misma
     que drawable/: fondo blanco + anillo órbita centrado. La variante
     oscura vive en res/drawable-night-v21/launch_background.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
