<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de inicio de Melli-Qui (mejorado, 2026-11-18, diseño v3:
     tarjeta blanca con cara, racha, tip, meta del día, vidas y
     puntos): se actualiza desde Dart cada vez que cambian los datos;
     el sistema lo repinta además una vez al día. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="170dp"
    android:updatePeriodMillis="86400000"
    android:initialLayout="@layout/melli_qui_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
